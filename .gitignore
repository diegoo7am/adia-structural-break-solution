# ==========================================
# 1. Data & Models
# ==========================================
# Ignore the entire data folder so you don't upload ADIA Lab datasets
data/
data/raw/
data/processed/

# Just in case you leave a data file lying around outside the folder
*.csv
*.parquet
*.h5
*.hdf5

# Ignore heavy saved models
*.pkl
*.joblib
*.pt
*.pth

# ==========================================
# 2. Python & Environments
# ==========================================
# Automatically generated compiled Python files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (NEVER upload these)
venv/
env/
.venv/
.conda/

# Environment variables files (where you would store passwords or API keys)
.env

# ==========================================
# 3. Jupyter Notebooks
# ==========================================
# Automatic save points for notebooks
.ipynb_checkpoints/

# ==========================================
# 4. IDE (Visual Studio Code)
# ==========================================
# Local VS Code settings that shouldn't be shared
.vscode/

# ==========================================
# 5. OS Generated Files
# ==========================================
# Hidden Mac and Windows files
.DS_Store
Thumbs.db